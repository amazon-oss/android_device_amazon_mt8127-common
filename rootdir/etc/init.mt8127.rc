import /init.device.rc

on init
    # Display
    mount debugfs none /sys/kernel/debug
    chown system system /d/ion/heaps/ion_mm_heap
    chown system media /proc/M4U_device
    chmod 0644 /proc/M4U_device
    chown system media /sys/bus/platform/drivers/mem_bw_ctrl/concurrency_scenario
    chmod 0664 /sys/bus/platform/drivers/mem_bw_ctrl/concurrency_scenario

on fs
    mount_all /fstab.mt8127

on post-fs-data
    # NVRAM
    mkdir /data/nvram 2771 root system

    # TEE
    mkdir /data/key_provisioning 0770 system system
    start kisd

    setprop vold.post_fs_data_done 1

on boot
    # NVRAM
    start NvRAMAgent

# Display
service pq /system/bin/pq
    class main
    user system
    group system graphics
    oneshot

on property:init.svc.servicemanager=restarting
    restart pq

# Media
service mediacodec /system/bin/mediacodec
    class main
    user mediacodec
    group camera drmrpc mediadrm audio media
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks

# NVRAM
service NvRAMAgent /system/bin/nvram_agent_binder
    user system
    group system

service nvram_daemon /system/bin/nvram_daemon
    class main
    user root
    group system bluetooth
    oneshot

on property:vold.decrypt=trigger_restart_framework
    start nvram_daemon

# TEE
service kisd /system/bin/kisd

service rpmb_svc /system/bin/rpmb_svc
    class main
    user root
    group root
    disabled

on property:ro.boot.rpmb_state=1
    start rpmb_svc
